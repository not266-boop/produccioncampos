    {
      "name": "17 Escalar rosquitas a 360 kg (5 tandas)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Factor 5', () => pm.expect(pm.response.json().factor).to.eql(5));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/api/recetas/{{recRosId}}/escalar?cantidad=360",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "api",
            "recetas",
            "{{recRosId}}",
            "escalar"
          ],
          "query": [
            {
              "key": "cantidad",
              "value": "360"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
