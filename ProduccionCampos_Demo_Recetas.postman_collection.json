{
  "info": {
    "name": "ProduccionCampos - Demo recetas reales",
    "description": "Carga 3 recetas reales de Panadería Campos con su rendimiento por tanda: Rosquitas de manteca (72 kg), Pasteles mil hojas / cachito (60 unidades) y Bizcochuelo (6 moldes redondos grandes), con sus 12 insumos. Stocks y costos de prueba. Requiere el backend con perfil dev.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('hoy', new Date().toISOString().slice(0,10));"
        ]
      }
    }
  ],
  "item": [
