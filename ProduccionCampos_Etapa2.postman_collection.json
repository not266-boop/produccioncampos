      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = new Date();",
              "const f = x => x.toISOString().slice(0, 10);",
              "pm.collectionVariables.set(\"desde\", f(new Date(d.getTime() - 86400000)));",
              "pm.collectionVariables.set(\"hasta\", f(new Date(d.getTime() + 86400000)));"
            ]
          }
        }
      ]
